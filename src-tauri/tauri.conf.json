{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapleHelper",
  "version": "0.1.0",
  "identifier": "com.filterkey.maple",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "메이플헬퍼",
        "width": 700,
        "height": 430,
        "minWidth": 660,
        "minHeight": 400,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
